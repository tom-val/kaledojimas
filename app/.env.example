# Copy to .env for local builds. In EAS builds these come from the EAS "production" environment.
# EXPO_PUBLIC_* values referenced from app code are inlined into the bundle — never put secrets here.

# Base URL of the API, WITHOUT a trailing slash and WITHOUT /v1:
#   production   https://<cloudfront-domain>   (CloudFront forwards /v1/* to API Gateway)
# Leave unset in development: the app uses the Metro dev-server host on port 3001, so a phone on the
# same Wi-Fi reaches `make api` with no edit here.
# EXPO_PUBLIC_API_URL=

# Google Maps key for the ANDROID map only (iOS uses Apple Maps, web uses OpenStreetMap).
# Google Cloud console -> enable "Maps SDK for Android" -> API key restricted to Android apps with
# package com.tomval.knockknock + the signing certificate SHA-1. Read only by app.config.ts.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=
